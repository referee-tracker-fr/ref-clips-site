// Hébergement du site REF CLIPS chez Cloudflare (remplace GitHub Pages).
{
  "name": "ref-clips",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
